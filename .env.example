GITHUB_TOKEN=your_github_token
GITHUB_USERNAME=your_github_username

# Authentication and MongoDB
AUTH_SECRET=replace_with_a_random_string_at_least_32_characters_long
AUTH_URL=http://localhost:3000
AUTH_GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/gitpulse
AUTH_GITHUB_ID=your_github_oauth_client_id
AUTH_GITHUB_SECRET=your_github_oauth_client_secret

# SMTP settings for password-reset OTP emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="GitPulse <no-reply@example.com>"

ANTHROPIC_API_KEY=your_anthropic_api_key

LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_PERSON_URN=your_linkedin_person_urn

META_PAGE_ACCESS_TOKEN=your_meta_page_access_token
META_PAGE_ID=your_meta_page_id
META_IG_BUSINESS_ID=your_instagram_business_id